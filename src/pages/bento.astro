---
/**
 * bento.astro — Bento Box Layout Portfolio Page
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import About from '../components/About.astro';
import TalkCard from '../components/TalkCard.astro';
import TopicCard from '../components/TopicCard.astro';
import VideoCard from '../components/VideoCard.astro';
import Footer from '../components/Footer.astro';
import Timeline from '../components/Timeline.astro';

import talksData from '../data/talks.json';
import videosData from '../data/videos.json';

// --- Build-time computations ---

// Tag config
const TAG_CONFIG: Record<string, { label: string }> = {
  keynote: { label: 'Keynote' },
  international: { label: 'International' },
  workshop: { label: 'Workshop' },
  talk: { label: 'Talk' },
  online: { label: 'Online' },
  panel: { label: 'Panel' }
};

// Topic config
const TOPIC_CONFIG: Record<string, { label: string }> = {
  opentelemetry: { label: 'OpenTelemetry' },
  aws: { label: 'AWS & Cloud Services' },
  adot: { label: 'ADOT (AWS Distro for OTel)' },
  kubernetes: { label: 'Kubernetes & Cloud-Native' },
  observability: { label: 'Full-Stack Observability' },
  'ai-llm': { label: 'AI / LLM Monitoring' },
  security: { label: 'SecurityOps & Observability' }
};
const TOPIC_ORDER = ['opentelemetry', 'aws', 'adot', 'kubernetes', 'observability', 'ai-llm', 'security'];

// Stats
const uniqueCountries = new Set<string>();
talksData.forEach(t => {
  const loc = t.location;
  if (loc.includes('Malaysia') || loc.includes('Kuala Lumpur')) uniqueCountries.add('Malaysia');
  else if (loc.includes('Singapore')) uniqueCountries.add('Singapore');
  else if (loc.includes('Online')) { /* skip */ }
  else uniqueCountries.add('India');
});

// Topics stats for Bento
interface TopicStat {
  count: number; keynotes: number; international: number; workshops: number;
  minYear: number; conferences: Set<string>;
}
const topicStats: Record<string, TopicStat> = {};
TOPIC_ORDER.forEach(t => {
  topicStats[t] = { count: 0, keynotes: 0, international: 0, workshops: 0, minYear: 9999, conferences: new Set() };
});
talksData.forEach((talk) => {
  (talk.topics || []).forEach((topic) => {
    if (!topicStats[topic]) return;
    topicStats[topic].count++;
    if (talk.tags.includes('keynote')) topicStats[topic].keynotes++;
    if (talk.tags.includes('international')) topicStats[topic].international++;
    if (talk.tags.includes('workshop')) topicStats[topic].workshops++;
    if (talk.year < topicStats[topic].minYear) topicStats[topic].minYear = talk.year;
    topicStats[topic].conferences.add(talk.event);
  });
});

---

<BaseLayout
  title="Zameer Fouzan | Bento Layout"
  description="Lead Developer Relations Engineer specialising in observability, OpenTelemetry, and cloud-native systems."
>
  <Nav />
  
  <div class="bento-container">
    <div class="bento-grid">
      
      <!-- HERO (Spans 2 cols) -->
      <div class="bento-item bento-hero reveal-on-scroll">
        <Hero />
      </div>

      <!-- STATS (Spans 1 col) -->
      <div class="bento-item bento-stats reveal-on-scroll" style="animation-delay: 0.1s">
        <Stats talkCount={talksData.length} countries={uniqueCountries.size} />
      </div>

      <!-- ABOUT (Spans 2 cols) -->
      <div class="bento-item bento-about reveal-on-scroll" style="animation-delay: 0.2s">
        <About />
      </div>

      <!-- VIDEOS (Spans 1 col, scrollable to match About height) -->
      <div class="bento-item bento-videos reveal-on-scroll" style="animation-delay: 0.3s">
        <div class="bento-header bento-sticky-header">
          <h3>Featured Videos</h3>
        </div>
        <div class="videos-scroll">
          {videosData.map((v: any) => (
            <VideoCard id={v.id} title={v.title} event={v.event} badge={v.badge} />
          ))}
        </div>
      </div>

      <!-- TIMELINE (Spans 2 cols) -->
      <div class="bento-item bento-timeline reveal-on-scroll" style="animation-delay: 0.4s">
        <div class="bento-header bento-sticky-header">
          <h3>Speaking Timeline</h3>
        </div>
        <div class="timeline-container">
          <Timeline />
        </div>
      </div>

      <!-- TOPICS (Spans 1 col) -->
      <div class="bento-item bento-topics reveal-on-scroll" style="animation-delay: 0.5s">
        <div class="bento-header bento-sticky-header">
          <h3>Expertise</h3>
        </div>
        <div class="topics-list">
          {TOPIC_ORDER.map(topic => {
            const s = topicStats[topic];
            if (s.count === 0) return null;
            return (
              <TopicCard
                topic={topic}
                label={TOPIC_CONFIG[topic]?.label || topic}
                count={s.count}
                events={s.conferences.size}
                keynotes={s.keynotes}
                workshops={s.workshops}
                international={s.international}
                since={s.minYear}
              />
            );
          })}
        </div>
      </div>

      <!-- CONTACT (Spans 3 cols) -->
      <div class="bento-item bento-contact reveal-on-scroll" style="animation-delay: 0.6s">
        <div class="contact-content">
          <h2>Let's Build Together</h2>
          <p>Interested in having me speak at your event, or want to collaborate on observability and cloud-native topics?</p>
          <div class="hero-links">
          <a href="https://linktr.ee/zmrfzn" target="_blank" rel="noopener" class="btn btn-primary">
            Get in Touch
          </a>
        </div>
        </div>
      </div>

    </div>
  </div>

  <Footer />
  <script src="../scripts/main.js"></script>
  <script>
    const syncHeights = () => {
      const aboutBox = document.querySelector('.bento-about');
      const videosBox = document.querySelector('.bento-videos');
      if (aboutBox && videosBox) {
        // Use offsetHeight to include padding and border
        videosBox.style.maxHeight = aboutBox.offsetHeight + 'px';
      }
    };
    
    // Run on load and on window resize
    window.addEventListener('load', syncHeights);
    window.addEventListener('resize', syncHeights);
    syncHeights();
  </script>

  <style>
    /* Bento Grid Styles */
    .bento-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
      padding-top: 6rem; /* Account for Nav */
    }

    .bento-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      grid-auto-flow: dense;
    }

    /* Flat & Borderless Design System */
    .bento-item {
      background-color: var(--bg-card);
      border-radius: 24px; /* Soft, friendly corners */
      padding: 2rem;
      display: flex;
      flex-direction: column;
      transition: opacity 0.2s ease, background-color 0.2s ease;
      overflow: clip; /* clip, NOT hidden — hidden kills position:sticky in children */
      border: none; /* NO BORDERS */
    }

    .bento-header h3 {
      font-size: 1.25rem;
      margin-bottom: 1.5rem;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .bento-header h3::before {
      content: '//';
      color: var(--accent);
      font-family: var(--font-mono, monospace);
      font-size: 1rem;
    }

    /* Grid Spans */
    .bento-hero { grid-column: span 2; }
    .bento-stats { grid-column: span 1; justify-content: center; }
    .bento-about { grid-column: span 2; }
    .bento-videos { grid-column: span 1; overflow-x: hidden; overflow-y: auto; scrollbar-width: thin; }
    .bento-timeline { 
      grid-column: span 2; 
      max-height: 800px; 
      overflow-x: hidden;
      overflow-y: auto; 
      scrollbar-width: thin; 
      --timeline-header-bg: var(--bg-card-hover);
    }
    .bento-topics { grid-column: span 1; max-height: 800px; overflow-x: hidden; overflow-y: auto; scrollbar-width: thin; }
    .bento-contact { grid-column: span 3; text-align: center; padding: 4rem 2rem; background: var(--accent-indigo); }
    .bento-contact h2, .bento-contact p { color: #fff; }

    /* Sticky headers inside scrollable bento tiles */
    .bento-sticky-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: var(--bg-card);
      padding: 2rem 2rem 1rem 2rem;
      margin: -2rem -2rem 1rem -2rem;
    }

    .contact-content {
      max-width: 600px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .contact-content h2 { font-size: 2.5rem; margin: 0; }
    .contact-content p { margin: 0; }

    /* Compact video cards inside bento */
    :global(.bento-videos .video-card) {
      border-radius: 10px;
    }
    :global(.bento-videos .video-thumbnail img) {
      height: 120px;
      object-fit: cover;
    }
    :global(.bento-videos .video-info) {
      padding: 8px 12px;
    }
    :global(.bento-videos .video-title) {
      font-size: 0.8rem;
      line-height: 1.3;
    }
    :global(.bento-videos .video-event) {
      font-size: 0.7rem;
    }

    /* Component Overrides for Bento Context */
    :global(.bento-hero .hero) { padding: 0; min-height: auto; }
    :global(.bento-hero .hero-row) { flex-direction: row; gap: 24px; }
    :global(.bento-hero .hero h1) { font-size: clamp(1.8rem, 3vw, 2.5rem); }
    
    :global(.bento-stats .stats-grid) { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    :global(.bento-stats .section) { padding: 0; }
    :global(.bento-stats .stat-card) { padding: 16px; }
    
    :global(.bento-about .section) { padding: 0; }
    :global(.bento-about .section-header) { margin-bottom: 12px; }
    
    :global(.bento-item .container) { max-width: none; padding: 0; }

    /* Scrollable areas styling */
    .videos-scroll, .topics-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    
    /* Scrollbar styling for internal bento scrolling */
    .bento-timeline,
    .bento-topics,
    .bento-videos {
      scrollbar-color: var(--accent) var(--bg-card);
    }
    .bento-timeline::-webkit-scrollbar,
    .bento-topics::-webkit-scrollbar,
    .bento-videos::-webkit-scrollbar {
      width: 4px;
    }
    .bento-timeline::-webkit-scrollbar-track,
    .bento-topics::-webkit-scrollbar-track,
    .bento-videos::-webkit-scrollbar-track {
      background-color: var(--bg-card);
      border-radius: 10px;
    }
    .bento-timeline::-webkit-scrollbar-thumb,
    .bento-topics::-webkit-scrollbar-thumb,
    .bento-videos::-webkit-scrollbar-thumb {
      background-color: var(--accent);
      border-radius: 10px;
    }

    /* Responsive Design */
    @media (max-width: 1024px) {
      .bento-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .bento-hero { grid-column: span 2; }
      .bento-stats { grid-column: span 2; }
      .bento-about { grid-column: span 2; }
      .bento-videos { grid-column: span 2; }
      .bento-timeline { grid-column: span 2; max-height: none; }
      .bento-topics { grid-column: span 2; max-height: none; }
      .bento-contact { grid-column: span 2; }
    }

    @media (max-width: 768px) {
      .bento-container {
        padding: 1rem;
        padding-top: 5rem;
      }
      .bento-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .bento-item {
        grid-column: span 1 !important;
        padding: 1.5rem;
      }
    }
  </style>
</BaseLayout>
