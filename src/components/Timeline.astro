---
// Timeline.astro - Year-grouped progressive disclosure timeline with backdrop spotlight
import talksData from '../data/talks.json';
import TalkCard from './TalkCard.astro';

// Group talks by year, sorted descending
type Talk = typeof talksData[number];
const talksByYear: Record<number, Talk[]> = {};
talksData.forEach((talk) => {
  if (!talksByYear[talk.year]) talksByYear[talk.year] = [];
  talksByYear[talk.year].push(talk);
});
const sortedYears = Object.keys(talksByYear).map(Number).sort((a, b) => b - a);
---

<div class="timeline reveal-on-scroll">
  {sortedYears.map((year) => (
    <details class="timeline-year-group">
      <summary class="timeline-year-summary">
        <span class="timeline-year-label">{year}</span>
        <span class="timeline-year-count">{talksByYear[year].length} talk{talksByYear[year].length > 1 ? 's' : ''}</span>
        <span class="timeline-year-chevron">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </span>
      </summary>
      <div class="timeline-year-content">
        {talksByYear[year].map((talk) => (
          <details class="timeline-item">
            <summary class="timeline-summary">
              <div class="timeline-meta">
                <span class="timeline-date">{talk.date}</span>
              </div>
              <div class="timeline-title-bar">
                <h4 class="timeline-title">{talk.title}</h4>
                <p class="timeline-event">{talk.event} &bull; {talk.location}</p>
              </div>
              <div class="timeline-indicator">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </summary>
            <div class="timeline-content">
              <TalkCard talk={talk} />
            </div>
          </details>
        ))}
      </div>
    </details>
  ))}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const talkItems = document.querySelectorAll('details.timeline-item');
    const overlay = document.getElementById('spotlight-overlay');

    talkItems.forEach(detail => {
      detail.addEventListener('toggle', () => {
        if (detail.open) {
          // Close other talk items (but not year groups)
          talkItems.forEach(other => {
            if (other !== detail && other.open) {
              other.removeAttribute('open');
            }
          });
          overlay?.classList.add('active');
        } else {
          const anyOpen = Array.from(talkItems).some(d => d.open);
          if (!anyOpen) overlay?.classList.remove('active');
        }
      });
    });

    // Close all when clicking overlay
    overlay?.addEventListener('click', () => {
      talkItems.forEach(d => d.removeAttribute('open'));
      overlay.classList.remove('active');
    });

    // Open the first two year groups by default (current and last year)
    const yearGroups = document.querySelectorAll('details.timeline-year-group');
    if (yearGroups.length > 0) yearGroups[0].setAttribute('open', '');
    if (yearGroups.length > 1) yearGroups[1].setAttribute('open', '');
  });
</script>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 30;
  }

  /* --- Year Group --- */
  .timeline-year-group {
    border-radius: 12px;
    overflow: hidden;
  }

  .timeline-year-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    background: var(--bg-secondary);
    cursor: pointer;
    list-style: none;
    user-select: none;
    border-radius: 12px;
    transition: background 0.2s ease;
  }
  .timeline-year-summary::-webkit-details-marker { display: none; }

  .timeline-year-summary:hover {
    background: var(--bg-card-hover);
  }

  .timeline-year-label {
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--accent);
    min-width: 50px;
  }

  .timeline-year-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .timeline-year-chevron {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
  }

  .timeline-year-group[open] > .timeline-year-summary {
    border-radius: 12px 12px 0 0;
  }

  .timeline-year-group[open] > .timeline-year-summary .timeline-year-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .timeline-year-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px;
    background: var(--bg-card);
    border-radius: 0 0 12px 12px;
  }

  /* --- Individual Talk Item --- */
  .timeline-item {
    background: var(--bg-card);
    border-radius: 10px;
    transition: background 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .timeline-item:hover {
    background: var(--bg-card-hover);
  }

  .timeline-item[open] {
    z-index: 50;
    box-shadow: 0 0 0 1px var(--accent-glow), var(--shadow-lg);
    background: var(--bg-card);
  }

  .timeline-summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .timeline-summary::-webkit-details-marker { display: none; }

  .timeline-meta {
    flex-shrink: 0;
    width: 80px;
  }

  .timeline-date {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .timeline-title-bar {
    flex: 1;
    min-width: 0;
  }

  .timeline-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 2px;
    color: var(--text-primary);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .timeline-event {
    font-size: 0.8rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .timeline-indicator {
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: var(--text-muted);
    display: flex;
    align-items: center;
  }

  .timeline-item[open] .timeline-indicator {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .timeline-content {
    padding: 0 16px 16px 112px;
    animation: slideDown 0.3s ease-out forwards;
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 600px) {
    .timeline-summary {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .timeline-meta {
      width: auto;
    }
    .timeline-indicator {
      display: none;
    }
    .timeline-content {
      padding: 0 16px 16px;
    }
    .timeline-title {
      white-space: normal;
    }
    .timeline-event {
      white-space: normal;
    }
  }
</style>
