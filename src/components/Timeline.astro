---
// Timeline.astro - Year-grouped progressive disclosure timeline with backdrop spotlight
import talksData from '../data/talks.json';
import TalkCard from './TalkCard.astro';

// Group talks by year, sorted descending
type Talk = typeof talksData[number];
const talksByYear: Record<number, Talk[]> = {};
talksData.forEach((talk) => {
  if (!talksByYear[talk.year]) talksByYear[talk.year] = [];
  talksByYear[talk.year].push(talk);
});
const sortedYears = Object.keys(talksByYear).map(Number).sort((a, b) => b - a);
---

<div class="timeline reveal-on-scroll">
  {sortedYears.map((year) => (
    <details class="timeline-year-group">
      <summary class="timeline-year-summary">
        <span class="timeline-year-label">{year}</span>
        <span class="timeline-year-count">{talksByYear[year].length} talk{talksByYear[year].length > 1 ? 's' : ''}</span>
        <span class="timeline-year-chevron">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </span>
      </summary>
      <div class="timeline-year-content">
        {talksByYear[year].map((talk) => (
          <TalkCard talk={talk} />
        ))}
      </div>
    </details>
  ))}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Open the first two year groups by default (current and last year)
    const yearGroups = document.querySelectorAll('details.timeline-year-group');
    if (yearGroups.length > 0) yearGroups[0].setAttribute('open', '');
    if (yearGroups.length > 1) yearGroups[1].setAttribute('open', '');
  });
</script>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* --- Year Group --- */
  .timeline-year-group {
    border-radius: 12px;
    overflow: hidden;
  }

  .timeline-year-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    background: var(--bg-card);
    cursor: pointer;
    list-style: none;
    user-select: none;
    border-radius: 12px;
    transition: background 0.2s ease;
  }
  .timeline-year-summary::-webkit-details-marker { display: none; }

  .timeline-year-summary:hover {
    background: var(--bg-card-hover);
  }

  .timeline-year-label {
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--text-primary);
    min-width: 50px;
  }

  .timeline-year-count {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .timeline-year-chevron {
    margin-left: auto;
    color: var(--text-muted);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
  }

  .timeline-year-group[open] > .timeline-year-summary {
    border-radius: 12px 12px 0 0;
  }

  .timeline-year-group[open] > .timeline-year-summary .timeline-year-chevron {
    transform: rotate(180deg);
    color: var(--accent);
  }

  .timeline-year-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: transparent;
    border-radius: 0 0 12px 12px;
  }
</style>
